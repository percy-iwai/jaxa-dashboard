<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2023.1.0' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <color-palette name='宇宙' type='regular'>
      <color>#003f7f</color>
      <color>#0066cc</color>
      <color>#3399ff</color>
      <color>#66b2ff</color>
      <color>#99ccff</color>
    </color-palette>
  </preferences>
  <datasources>
    <datasource caption='宇宙関連行政事業レビュー' inline='true' name='textscan.1' version='18.1'>
      <connection class='textscan' directory='.' filename='jaxa_space_review.csv' locale='ja_JP' separator=',' server='' validate='no'>
        <relation name='jaxa_space_review.csv' table='[jaxa_space_review#csv]' type='table' />
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>年度</remote-name>
            <remote-type>130</remote-type>
            <local-name>[年度]</local-name>
            <parent-name>[jaxa_space_review#csv]</parent-name>
            <local-type>integer</local-type>
            <aggregation>Year</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>府省</remote-name>
            <remote-type>130</remote-type>
            <local-name>[府省]</local-name>
            <parent-name>[jaxa_space_review#csv]</parent-name>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>組織</remote-name>
            <remote-type>130</remote-type>
            <local-name>[組織]</local-name>
            <parent-name>[jaxa_space_review#csv]</parent-name>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>予算事業ID</remote-name>
            <remote-type>130</remote-type>
            <local-name>[予算事業ID]</local-name>
            <parent-name>[jaxa_space_review#csv]</parent-name>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>事業名</remote-name>
            <remote-type>130</remote-type>
            <local-name>[事業名]</local-name>
            <parent-name>[jaxa_space_review#csv]</parent-name>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>予算額（百万円）</remote-name>
            <remote-type>5</remote-type>
            <local-name>[予算額（百万円）]</local-name>
            <parent-name>[jaxa_space_review#csv]</parent-name>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>うち当初予算（百万円）</remote-name>
            <remote-type>5</remote-type>
            <local-name>[うち当初予算（百万円）]</local-name>
            <parent-name>[jaxa_space_review#csv]</parent-name>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>うち補正予算（百万円）</remote-name>
            <remote-type>5</remote-type>
            <local-name>[うち補正予算（百万円）]</local-name>
            <parent-name>[jaxa_space_review#csv]</parent-name>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>執行額（前年度実績・百万円）</remote-name>
            <remote-type>5</remote-type>
            <local-name>[執行額（前年度実績・百万円）]</local-name>
            <parent-name>[jaxa_space_review#csv]</parent-name>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>執行率（前年度・%）</remote-name>
            <remote-type>5</remote-type>
            <local-name>[執行率（前年度・%）]</local-name>
            <parent-name>[jaxa_space_review#csv]</parent-name>
            <local-type>real</local-type>
            <aggregation>Average</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column datatype='integer' name='[年度]' role='dimension' type='ordinal' />
      <column datatype='string' name='[府省]' role='dimension' type='nominal' />
      <column datatype='string' name='[組織]' role='dimension' type='nominal' />
      <column datatype='string' name='[予算事業ID]' role='dimension' type='nominal' />
      <column datatype='string' name='[事業名]' role='dimension' type='nominal' />
      <column datatype='real' default-format='n#,##0百万円' name='[予算額（百万円）]' role='measure' type='quantitative' />
      <column datatype='real' default-format='n#,##0百万円' name='[うち当初予算（百万円）]' role='measure' type='quantitative' />
      <column datatype='real' default-format='n#,##0百万円' name='[うち補正予算（百万円）]' role='measure' type='quantitative' />
      <column datatype='real' default-format='n#,##0百万円' name='[執行額（前年度実績・百万円）]' role='measure' type='quantitative' />
      <column datatype='real' default-format='p0.0%' name='[執行率（前年度・%）]' role='measure' type='quantitative' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='年度別予算額'>
      <table>
        <view>
          <datasources>
            <datasource caption='宇宙関連行政事業レビュー' name='textscan.1' />
          </datasources>
          <aggregation value='true' />
        </view>
      </table>
      <panes>
        <pane>
          <mark class='Bar' />
          <encodings>
            <column field='[textscan.1].[年度]' />
            <row field='[textscan.1].[予算額（百万円）]' />
            <color field='[textscan.1].[府省]' />
          </encodings>
        </pane>
      </panes>
      <rows>[textscan.1].[予算額（百万円）]</rows>
      <cols>[textscan.1].[年度]</cols>
    </worksheet>
    <worksheet name='事業一覧'>
      <table>
        <view>
          <datasources>
            <datasource caption='宇宙関連行政事業レビュー' name='textscan.1' />
          </datasources>
          <aggregation value='true' />
        </view>
      </table>
      <panes>
        <pane>
          <mark class='Text' />
          <encodings>
            <row field='[textscan.1].[府省]' />
            <row field='[textscan.1].[事業名]' />
            <column field='[textscan.1].[年度]' />
            <text field='[textscan.1].[予算額（百万円）]' />
          </encodings>
        </pane>
      </panes>
      <rows>[textscan.1].[府省],[textscan.1].[事業名]</rows>
      <cols>[textscan.1].[年度]</cols>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='宇宙関連予算ダッシュボード'>
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' />
      <zones>
        <zone h='100000' id='3' type='layout-flow' w='100000' x='0' y='0'>
          <zone h='50000' id='1' name='年度別予算額' type='worksheet' w='100000' x='0' y='0' />
          <zone h='50000' id='2' name='事業一覧' type='worksheet' w='100000' x='0' y='50000' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
</workbook>
